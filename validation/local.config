/*
 * validation/local.config: run the validation panel on a laptop
 *
 *   nextflow run main.nf -profile docker,emulate_amd64 -c validation/local.config ...
 *
 * Without the test profile nothing caps how many tasks run at once. The local
 * executor would plan against the Mac's full 16 GB, but Docker Desktop only
 * has 11.7 GB (CLAUDE.md D17), so tasks could be killed for lack of memory.
 */
executor {
    cpus   = 8
    memory = 10.GB
}
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 2.h ]
}
