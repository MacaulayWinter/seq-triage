/*
 * Layer D settings: copy to settings.config and fill in. settings.config is
 * in .gitignore: account names and database paths never enter the repository.
 */
params.kraken2_db = '/path/to/kraken2_db'   // folder containing hash.k2d
process.queue          = 'your_partition'   // e.g. the cluster's default partition
process.clusterOptions = '-A your_account'
// Kraken2 needs about as much memory as the database (Standard-8: ~8 GB, so
// 16 GB; the full Standard database: ~94 GB, so 100 GB)
process {
    withName: 'KRAKEN2|KRAKEN2_BATCH' { memory = 16.GB; cpus = 4; time = 2.h }
}
// Big database (full Standard, ~94 GB)? Read it once for the whole run (D50):
// params.kraken2_batch = true   and set memory = 100.GB, time = 12.h above.
