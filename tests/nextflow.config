// Settings for nf-test runs (nf-test.config points here).
params {
    // nf-core test data, pinned by commit like the test profile (D30)
    test_data = 'https://raw.githubusercontent.com/nf-core/test-datasets/76179c1c8765b0233ba72d3fb82bc142f1d92b13/data/genomics/'
}
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}

// test_data is a helper for the module tests, not a pipeline parameter. The
// pipeline rejects unknown parameters (D19), which is what we want in real
// runs, so it is allowed here and only here.
validation {
    ignoreParams = [ 'test_data' ]
}
