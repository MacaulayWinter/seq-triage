/*
 * seq-triage: per-process options (ext.args) and where outputs are published
 *
 * Modules never hard-code arguments or output paths; nf-core modules read
 * task.ext.args, and publishDir is set here, so all of it is in one place.
 */

process {

    // Default: results/<tool>/, e.g. FASTQC -> results/fastqc/
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
    ]

    withName: 'SCREEN_METADATA' {
        publishDir = [ path: { "${params.outdir}/metadata" }, mode: params.publish_dir_mode ]
    }

    // BAM input (D55). CHECK_BAM's verdicts go next to CHECK_FASTQ's.
    // D69: the converted reads are working files and are never published
    // (the e2e check "no FASTQ files published" caught the default doing so);
    // only the per-file status table goes next to the other integrity checks.
    withName: 'NORMALISE_FASTQ' {
        publishDir = [ path: { "${params.outdir}/integrity" }, mode: params.publish_dir_mode, pattern: '*.normalise.tsv' ]
    }
    withName: 'CHECK_BAM' {
        publishDir = [ path: { "${params.outdir}/integrity" }, mode: params.publish_dir_mode ]
    }
    // The converted reads are working files, never results: nothing is
    // published (the repository's data rule applies to results/ too).
    // -F 0x900 (samtools fastq, ext.args2) leaves out secondary and
    // supplementary alignments, so every read is counted once; it is
    // samtools' default, written out so a samtools update cannot change it.
    // pipefail: the module pipes samtools collate into samtools fastq. Without
    // it, a BAM damaged part-way would make collate fail while fastq still
    // exits 0, and the task would pass with only some of the reads (the
    // same silent failure seqkit showed in round 1, D39).
    withName: 'SAMTOOLS_COLLATEFASTQ' {
        shell      = [ '/bin/bash', '-euo', 'pipefail' ]
        ext.args2  = '-F 0x900'
        publishDir = [ enabled: false ]
    }

    // D75: merged reads of a several-file sample are an intermediate, like
    // reads converted from a BAM: never published (no FASTQ in results).
    withName: 'CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'CHECK_FASTQ' {
        publishDir = [ path: { "${params.outdir}/integrity" }, mode: params.publish_dir_mode ]
    }
    withName: 'SEQKIT_STATS' {
        publishDir = [ path: { "${params.outdir}/detection/seqkit" }, mode: params.publish_dir_mode ]
    }

    withName: 'DETECT_PLATFORM|COMBINE_DETECTION' {
        publishDir = [ path: { "${params.outdir}/detection" }, mode: params.publish_dir_mode ]
    }

    withName: 'FASTP' {
        // Publish the QC reports only. The trimmed reads stay in work/: this
        // is triage, not preprocessing, and reads never belong in results/.
        publishDir = [ path: { "${params.outdir}/fastp" }, mode: params.publish_dir_mode,
                       pattern: '*.{json,html,log}' ]
    }

    withName: 'NANOPLOT' {
        // NanoPlot always writes "NanoStats.txt"; the prefix keeps samples
        // apart in results/ and in MultiQC.
        // --tsv_stats: NanoStats.txt as machine-readable "field<TAB>value"
        // (number_of_reads, n50, mean_qual ...), the names metric_guide.tsv uses.
        ext.args = { "--prefix ${meta.id}_ --tsv_stats" }
    }

    withName: 'KRAKEN2_BATCH' {
        publishDir = [ path: { "${params.outdir}/contamination/kraken2" }, mode: params.publish_dir_mode, pattern: '*report.txt' ]
    }
    withName: 'KRAKEN2' {
        ext.args   = { params.kraken2_memory_mapping ? '--memory-mapping' : '' }
        publishDir = [ path: { "${params.outdir}/contamination/kraken2" }, mode: params.publish_dir_mode, pattern: '*report.txt' ]
    }
    withName: 'BRACKEN' {
        ext.args   = { "-l S -r ${params.bracken_read_length}" }
        publishDir = [ path: { "${params.outdir}/contamination/bracken" }, mode: params.publish_dir_mode ]
    }
    withName: 'UNTAR' {
        publishDir = [ enabled: false ]
    }
    withName: 'TRIAGE_REPORT' {
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode ]
    }
    // results/recommendations/ (D66)
    withName: 'RECOMMEND' {
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode ]
    }
}
