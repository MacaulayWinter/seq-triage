/*
 * seq-triage: test profile
 *
 * Runs the whole pipeline on six small public samples (~17 MB, see
 * assets/samplesheet_test.csv and CLAUDE.md D25). Every row has a known
 * correct answer, so this profile is the end-to-end test.
 *
 *   nextflow run main.nf -profile test,docker                  (Linux, CI)
 *   nextflow run main.nf -profile test,docker,emulate_amd64    (Apple Silicon)
 */

params {
    input  = "${projectDir}/assets/samplesheet_test.csv"
    outdir = 'results'
    // nf-core's tiny SARS-CoV-2 Kraken2+Bracken database (49 KB), pinned by
    // commit. It tests the screen's plumbing, not its accuracy: bacterial
    // samples come out unclassified. Accuracy is validated separately (D41).
    kraken2_db = 'https://raw.githubusercontent.com/nf-core/test-datasets/76179c1c8765b0233ba72d3fb82bc142f1d92b13/data/genomics/sarscov2/genome/db/kraken2_bracken.tar.gz'
    // Reference for the CRAM test sample (D69), same pinned commit.
    cram_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/76179c1c8765b0233ba72d3fb82bc142f1d92b13/data/genomics/homo_sapiens/genome/genome.fasta'
    // D81: rRNA screen PLUMBING only, like the Kraken2 test database (D41):
    // the SARS-CoV-2 genome stands in for an rRNA reference, so every share
    // is near 0. Real use: SortMeRNA's databases (see README).
    rrna_db    = 'https://raw.githubusercontent.com/nf-core/test-datasets/76179c1c8765b0233ba72d3fb82bc142f1d92b13/data/genomics/sarscov2/genome/genome.fasta'
    // D96: a list built from the synthetic test fixtures (tests/pathogens/),
    // not the published one: tests the plumbing offline, like the databases above.
    pathogen_list = "${projectDir}/tests/pathogens/test_profile_list"
    sylph_db      = "${projectDir}/tests/sylph/test_db.syldb"   // D99: two genomes, 80 KB
}

process {
    // Cap every task to fit a private-repo GitHub Actions runner (about
    // 2 CPUs / 7 GB) and the Docker Desktop VM on the author's Mac (11.7 GB).
    // resourceLimits caps requests, including doubled memory on retry,
    // instead of letting a task ask for more than the machine has.
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
