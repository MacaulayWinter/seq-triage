/*
 * seq-triage: base resource and error-handling config
 *
 * Label names follow the nf-core convention (process_single ... process_high)
 * because the nf-core modules we install already declare them. The VALUES are
 * our own: nf-core's template defaults are sized for HPC (process_high asks
 * for 72 GB), but every tool in seq-triage is a lightweight QC tool, so these
 * are sized to run on a laptop. See CLAUDE.md D17.
 */

process {

    // Defaults for any process without a label.
    cpus   = { 1                   }
    memory = { 2.GB * task.attempt }
    time   = { 1.h  * task.attempt }

    // Retry once, with doubled memory and time (task.attempt = 2), but only
    // for exit codes that mean "the task was killed", not "the tool failed":
    //   104      kept from the nf-core template, where it is retried as a
    //            transient failure (104 is ECONNRESET, "connection reset by
    //            peer", in Linux errno numbering)
    //   130-145  128 + signal number: killed by a signal, most often
    //            137 = SIGKILL from the out-of-memory killer, 143 = SIGTERM
    // Any other non-zero exit is a real error, so retrying would only hide it.
    // 'finish' lets tasks that are already running complete, then stops
    // cleanly, so -resume picks up from there.
    // Not included: 175-177, which are Fusion Snapshot (Seqera/AWS spot)
    // codes from the nf-core template. Add them only if running with Fusion.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // CPUs do not scale with task.attempt: an out-of-memory kill is fixed by
    // more memory, not more threads.
    withLabel: process_single {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2                   }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4                   }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8                    }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
}
