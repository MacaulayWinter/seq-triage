// nf-test: Nextflow's testing framework, as used by nf-core (CLAUDE.md D46).
// Run from the repository root:  nf-test test --profile docker
// (on Apple Silicon: --profile docker,arm64)
config {
    testsDir   "."
    workDir    System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    // nf-core's own module tests need nf-core's test harness; nf-core runs them.
    ignore     "modules/nf-core/**/*"
}
