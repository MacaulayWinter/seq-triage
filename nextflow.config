/*
 * seq-triage: main configuration
 *
 * Read top to bottom: what the pipeline is (manifest), what it accepts
 * (params), what it depends on (plugins), how it runs (profiles), and what it
 * records about each run (reports). Resource settings live in conf/base.config.
 */

manifest {
    name            = 'MacaulayWinter/seq-triage'
    description     = 'Detect sequencing platform, validate metadata, route QC, summarise'
    homePage        = 'https://github.com/MacaulayWinter/seq-triage'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    version         = '0.1.0dev'
    // '!' makes this a hard requirement: Nextflow refuses to run on an older
    // version instead of only warning. CI pins the exact version with NXF_VER.
    nextflowVersion = '!>=26.10.0'
    contributors    = [
        [ name: 'Macaulay Winter', github: 'MacaulayWinter', contribution: ['author', 'maintainer'] ]
    ]
}

params {
    // Inputs
    input            = null        // samplesheet CSV; required, enforced by nf-schema
    metric_guide     = "${projectDir}/assets/metric_guide.tsv"
    species_groups   = "${projectDir}/assets/species_groups.tsv"   // look-alike species judged as one (D41)

    // Contamination screen (v0.2, CLAUDE.md D41). Off unless a Kraken2
    // database is given: a directory, or a .tar.gz that is unpacked first.
    kraken2_db             = null
    kraken2_memory_mapping = false   // true: read the database from disk instead of loading it into memory (laptops)
    kraken2_batch          = false   // true: one Kraken2 task for all samples, one database load (big databases on an HPC; D50)
    bracken_read_length    = 150     // must match a database*mers.kmer_distrib file in the database

    // Outputs
    outdir           = 'results'
    publish_dir_mode = 'copy'      // copy, not symlink: results survive deleting work/
}

// Resource labels and retry policy; per-process arguments and publishing.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

plugins {
    // Pinned to an exact version. 3.0.0 exists but is a new major release with
    // breaking API changes, and nf-core code still targets 2.x (see CLAUDE.md D16).
    id 'nf-schema@2.8.0'
}

// Fail, don't warn, on anything the schemas do not recognise. A typo such as
// --outdr would otherwise be ignored, and a samplesheet column misspelled
// "fastq2" would be dropped, silently turning paired data into single-end.
validation {
    logging {
        unrecognisedParams  = 'error'
        unrecognisedHeaders = 'error'
    }
    // --help lists every parameter from nextflow_schema.json (descriptions,
    // types, defaults); --help <name> explains one; --helpFull shows all,
    // including hidden ones. Generated from the schema, so it cannot drift
    // from what the pipeline accepts (CLAUDE.md D53).
    help {
        enabled    = true
        command    = "nextflow run MacaulayWinter/seq-triage -profile docker --input samplesheet.csv --outdir results"
        beforeText = "seq-triage: detect sequencing platform, validate metadata, route QC, summarise.\n"
        afterText  = "\nSamplesheet columns: sample, fastq_1, fastq_2, platform, sample_type, molecule (README: Usage).\nApple Silicon: add arm64 to -profile (docker,arm64). HPC without containers: -profile conda,slurm.\n"
    }
}

// nf-core modules name containers relative to a registry
// (e.g. 'biocontainers/fastp:...'), so the registry is set once here.
docker.registry = 'quay.io'

profiles {
    docker {
        docker.enabled    = true
        conda.enabled     = false
        // Run as your own user so output files are not owned by root.
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Apple Silicon: run amd64-only containers under Rosetta emulation.
    // Use AFTER docker (-profile docker,emulate_amd64): later profiles win,
    // so this runOptions replaces the docker one and must repeat the -u flag.
    // Same name as the nf-core template profile, so it is familiar.
    emulate_amd64 {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    // Apple Silicon, mostly native (use instead of emulate_amd64, AFTER docker:
    // -profile docker,arm64). nf-core's generated arm64 map gives native
    // images for seqkit, fastp, FastQC and MultiQC; the pinned R image is
    // multi-architecture, so the same digest runs natively. Images that exist
    // only for amd64 (checked 2026-10-21: NanoPlot, Kraken2, Bracken, untar)
    // stay emulated. The platform is stated for every process, so Docker
    // cannot quietly reuse an emulated copy already on disk (D44).
    arm64 {
        includeConfig 'conf/containers_docker_arm64.config'
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            containerOptions = '--platform=linux/arm64'
            // Every process whose image is amd64-only must be listed here,
            // or Docker refuses to run it ("does not provide the specified
            // platform"). KRAKEN2_BATCH added with D50.
            withName: 'NANOPLOT|KRAKEN2|KRAKEN2_BATCH|BRACKEN|UNTAR' {
                containerOptions = '--platform=linux/amd64'
            }
            // Local module on the nf-core samtools image: its arm64 build,
            // the tag nf-core's map gives SAMTOOLS_COLLATEFASTQ (D55).
            withName: 'CHECK_BAM' {
                container = 'community.wave.seqera.io/library/htslib_samtools_xz:c19e08fccce0b773'
            }
        }
    }
    // For machines without Docker, Apptainer or Singularity (e.g. many HPCs).
    // Each process builds its own environment from its pinned
    // environment.yml (bioconda / conda-forge). Exact tool versions are
    // pinned, but package builds can differ over time, so
    // pipeline_info/software_versions.tsv is the record of what ran (D42).
    // Set NXF_CONDA_CACHEDIR to keep the environments between runs.
    conda {
        conda.enabled     = true
        docker.enabled    = false
        conda.channels    = [ 'conda-forge', 'bioconda' ]
        conda.createTimeout = '1 h'
    }
    // Submit each task as a SLURM job. Cluster-specific settings (account,
    // partition) do NOT belong in this repository: put them in a small
    // config of your own and add it with -c, for example
    //     process.queue          = 'my_partition'
    //     process.clusterOptions = '-A my_account'
    slurm {
        process.executor        = 'slurm'
        executor.queueSize      = 50
        executor.submitRateLimit = '10/1min'
    }
    // End-to-end test on six small public samples (CLAUDE.md D25).
    test {
        includeConfig 'conf/test.config'
    }
}

// Run records (reproducibility layer 4). Overwrite rather than timestamp so
// the latest run is always in a predictable place.
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
// The workflow as a diagram of processes and channels (Mermaid HTML, opens
// in any browser): shows how this run's samples were routed.
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
